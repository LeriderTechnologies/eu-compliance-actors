{
  "actorSpecification": 1,
  "fields": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "description": "One item per number. Malformed items carry only index + error and are not charged.",
    "properties": {
      "index": {
        "type": [
          "integer",
          "null"
        ],
        "description": "Position in your input (0-based)"
      },
      "eori": {
        "type": [
          "string",
          "null"
        ],
        "description": "EORI as checked (no spaces, GR -> EL)"
      },
      "country": {
        "type": [
          "string",
          "null"
        ],
        "description": "Country prefix"
      },
      "format_ok": {
        "type": [
          "boolean",
          "null"
        ],
        "description": "Offline format check (2 letters + 1-15 letters/digits)"
      },
      "trader": {
        "type": [
          "object",
          "null"
        ],
        "description": "Name and address from EOS, only if the trader agreed to publish them"
      },
      "status": {
        "type": [
          "string",
          "null"
        ],
        "description": "valid / invalid = the EU service answered (charged once per distinct number); invalid_format, not_checkable, unavailable = not charged"
      },
      "valid": {
        "type": [
          "boolean",
          "null"
        ],
        "description": "true / false, null = not known"
      },
      "checked_at": {
        "type": [
          "string",
          "null"
        ],
        "description": "When the EU service was asked (UTC, ISO 8601)"
      },
      "detail": {
        "type": [
          "string",
          "null"
        ],
        "description": "Why the status is what it is"
      },
      "source": {
        "type": [
          "string",
          "null"
        ],
        "description": "Which official EU service answered"
      },
      "duplicate_of": {
        "type": [
          "integer",
          "null"
        ],
        "description": "Index of the same number earlier in this batch (not charged again)"
      },
      "error": {
        "type": [
          "string",
          "null"
        ],
        "description": "Malformed item (not charged)"
      }
    },
    "required": [
      "index"
    ]
  },
  "views": {
    "overview": {
      "title": "Results",
      "transformation": {
        "fields": [
          "index",
          "eori",
          "status",
          "valid",
          "trader",
          "detail",
          "error"
        ]
      },
      "display": {
        "component": "table",
        "properties": {
          "index": {
            "label": "Index"
          },
          "eori": {
            "label": "Eori"
          },
          "status": {
            "label": "Status"
          },
          "valid": {
            "label": "Valid"
          },
          "trader": {
            "label": "Trader"
          },
          "detail": {
            "label": "Detail"
          },
          "error": {
            "label": "Error"
          }
        }
      }
    }
  }
}
